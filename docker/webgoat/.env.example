# Portas de host para acessar o WebGoat e o WebWolf (127.0.0.1:<porta>).
# Copie este arquivo para .env nesta mesma pasta caso alguma porta padrao
# esteja ocupada por outro processo nesta maquina; nao e necessario editar
# o docker-compose.yml.
#
# WEBGOAT_HTTP_PORT usa 8081 em vez do 8080 sugerido pelo roteiro do
# trabalho porque a porta 8080 ja esta em uso nesta maquina por outro
# projeto sem relacao com este trabalho. A porta interna do container
# continua 8080.
WEBGOAT_HTTP_PORT=8081
WEBWOLF_HTTP_PORT=9090
